# Postgres (Neon) — SQLAlchemy 2.0 async, so the driver is asyncpg.
# Neon's dashboard gives you postgresql://user:pass@host/db?sslmode=require —
# convert it to this form: postgresql+asyncpg://user:pass@host/db?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Redis (Upstash) — used by the Trigger/Executor queue (Phase 6)
REDIS_URL=redis://default:password@host:port

# Angel One SmartAPI — quote/LTP endpoints ONLY, never order placement (Phase 6)
SMARTAPI_KEY=
SMARTAPI_CLIENT_ID=
SMARTAPI_PASSWORD=
SMARTAPI_TOTP_SECRET=

# Risk Manager rules (Phase 6) — fractions, e.g. 0.05 = 5%. Optional;
# defaults live in app/config.py if unset.
STOP_LOSS_PCT=0.05
MAX_POSITION_SIZE_PCT=0.20
MAX_TOTAL_EXPOSURE_PCT=0.60

# Origins allowed to call the API from a browser (comma-separated). Defaults
# to the Vite dev server; add the deployed frontend URL here in Phase 9.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
